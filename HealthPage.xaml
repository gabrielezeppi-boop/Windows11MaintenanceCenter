<Page
 x:Class="Windows11MaintenanceCenter.Views.HealthPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer>
  <StackPanel Padding="28" Spacing="12">
   <TextBlock Text="Stato e integrità" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="Queste operazioni sono diagnostiche: non eseguono riparazioni automatiche." Opacity="0.75" TextWrapping="Wrap"/>
   <StackPanel Spacing="8">
    <Button Content="Informazioni PC" Click="System_Click" ToolTipService.ToolTip="Mostra versione, build, architettura e spazio libero."/>
    <Button Content="Controllo rapido Windows" Click="DismCheck_Click" ToolTipService.ToolTip="Controllo DISM rapido, senza riparazione."/>
    <Button Content="Analisi approfondita Windows" Click="DismScan_Click" ToolTipService.ToolTip="Analisi DISM più lunga, senza riparazione."/>
    <Button Content="Verifica file di sistema" Click="Sfc_Click" ToolTipService.ToolTip="SFC /verifyonly: controlla senza riparare."/>
    <Button Content="Controllo del disco" Click="Chkdsk_Click" ToolTipService.ToolTip="CHKDSK /scan: controllo online senza /F /R /X."/>
    <Button Content="Controllo servizi" Click="Services_Click" ToolTipService.ToolTip="Legge lo stato di servizi selezionati senza modificarli."/>
    <Button Content="Riavvio necessario?" Click="Reboot_Click" ToolTipService.ToolTip="Verifica se Windows richiede un riavvio."/>
   </StackPanel>
   <Border Padding="18" CornerRadius="12">
    <StackPanel Spacing="6">
     <TextBlock Text="STATO" FontSize="13" FontWeight="SemiBold" Opacity="0.75"/>
     <TextBlock x:Name="StatusLabel" Text="PRONTO" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusSummary" Text="Seleziona un controllo." TextWrapping="Wrap"/>
     <TextBlock x:Name="StatusDetail" Opacity="0.75" TextWrapping="Wrap"/>
     <TextBlock x:Name="Elapsed" Text="Tempo trascorso: 00:00" Opacity="0.75"/>
     <ProgressBar x:Name="Progress" IsIndeterminate="False" Height="5"/>
    </StackPanel>
   </Border>
   <Expander Header="Dettagli tecnici">
    <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</Page>